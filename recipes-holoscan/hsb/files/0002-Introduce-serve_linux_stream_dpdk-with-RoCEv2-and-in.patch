+	ret = rte_eth_tx_burst(portid, 0, &mbuf, 1);
+	if (ret <= 0) {
+            fprintf(stderr, "packet not sent ret= %d port id = %d\n", ret, portid);
+            rte_pktmbuf_free(mbuf);
