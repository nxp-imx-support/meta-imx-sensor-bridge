+/**
+ * Pack 16-bit BG10 data into CSI-2 RAW10 format
+ * 4 pixels (10-bit each) packed into 5 bytes
+ */
+void pack_raw10(const uint16_t* input, uint8_t* output, size_t width, size_t height) {
+    for (size_t y = 0; y < height; y++) {
+        size_t in_row_offset = y * width;
+        size_t out_row_offset = y * (width * 10 / 8);
+
+        for (size_t x = 0; x < width; x += 4) {
+            size_t in_idx = in_row_offset + x;
+            size_t out_idx = out_row_offset + (x * 10 / 8);
+
+            uint16_t p0 = input[in_idx + 0] & 0x3FF;
+            uint16_t p1 = input[in_idx + 1] & 0x3FF;
+            uint16_t p2 = input[in_idx + 2] & 0x3FF;
+            uint16_t p3 = input[in_idx + 3] & 0x3FF;
+
+            // Pack: [P0[9:2], P1[9:2], P2[9:2], P3[9:2], P3[1:0]P2[1:0]P1[1:0]P0[1:0]]
+            output[out_idx + 0] = (p0 >> 2) & 0xFF;
+            output[out_idx + 1] = (p1 >> 2) & 0xFF;
+            output[out_idx + 2] = (p2 >> 2) & 0xFF;
+            output[out_idx + 3] = (p3 >> 2) & 0xFF;
+            output[out_idx + 4] = ((p3 & 0x3) << 6) | ((p2 & 0x3) << 4) |
+                                   ((p1 & 0x3) << 2) | ((p0 & 0x3) << 0);
+        }
+    }
+}
