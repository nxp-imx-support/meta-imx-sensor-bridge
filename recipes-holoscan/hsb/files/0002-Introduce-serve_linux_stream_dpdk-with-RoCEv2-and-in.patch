+	if (file) {
+		dtb_entry = (char *)malloc(MAX_LINE_SIZE);
+		if (!dtb_entry) {
+			printf("malloc failed!!");
+			rt = -1;
+			fclose(file);
+			goto err;
+		}
+		memset(dtb_entry, 0, MAX_LINE_SIZE);
+		cnt = fread(dtb_entry, sizeof(char), MAX_LINE_SIZE, file);
+		/* fread success */
+		if (cnt) {
+			ret = sscanf(EXTRACT_CCSR_ADDR(dtb_entry), "%lx",
+					 ccsr_addr);
+			if (ret != 1) {
+				printf("sscanf failed!!");
+				rt = -1;
+				free(dtb_entry);
+				fclose(file);
+				goto err;
+			}
+			*ccsr_size = ISI_CCSR_SIZE;
+			printf("%s ccsr_addr=0x%lx\n", __func__, *ccsr_addr);
+		}
+		free(dtb_entry);
+		fclose(file);
+	} else {
+		printf("File open failed!!");
+		rt = -1;
+		goto err;
+	}
+
+err:
+		return rt;
+}
+
+static inline int
+port_init(uint16_t port, struct rte_mempool *mbuf_pool)
+{
+        const uint16_t rx_rings = 1, tx_rings = 1;
+        uint16_t nb_rxd = RX_RING_SIZE;
+        uint16_t nb_txd = TX_RING_SIZE;
+        int retval;
+        uint16_t q;
+        struct rte_eth_dev_info dev_info;
+        struct rte_eth_txconf txconf;
+        struct rte_eth_rxconf rxconf;
+        struct rte_eth_conf local_port_conf = port_conf;
+
+        if (!rte_eth_dev_is_valid_port(port))
+                return -1;
+
+        retval = rte_eth_dev_info_get(port, &dev_info);
+        if (retval != 0) {
+                printf("Error during getting device (port %u) info: %s\n",
+                                port, strerror(-retval));
+                return retval;
+        }
+
+#if DPDK_VER_GE(22, 11)
+	if (dev_info.tx_offload_capa & RTE_ETH_TX_OFFLOAD_MBUF_FAST_FREE) { //for 22.11 onwards
+                local_port_conf.txmode.offloads |=
+                        RTE_ETH_TX_OFFLOAD_MBUF_FAST_FREE;
+	}
+#else
+	if (dev_info.tx_offload_capa & DEV_TX_OFFLOAD_MBUF_FAST_FREE) {
+                local_port_conf.txmode.offloads |=
+                        DEV_TX_OFFLOAD_MBUF_FAST_FREE;
+	}
+#endif
+
+        /* Configure the Ethernet device. */
+        retval = rte_eth_dev_configure(port, rx_rings, tx_rings, &local_port_conf);
+        if (retval != 0)
+                return retval;
+
+        retval = rte_eth_dev_adjust_nb_rx_tx_desc(port, &nb_rxd, &nb_txd);
+        if (retval != 0)
+                return retval;
+
+        rxconf = dev_info.default_rxconf;
+        rxconf.offloads = local_port_conf.rxmode.offloads;
+        /* Allocate and set up 1 RX queue per Ethernet port. */
+        for (q = 0; q < rx_rings; q++) {
+                retval = rte_eth_rx_queue_setup(port, q, nb_rxd,
+                                rte_eth_dev_socket_id(port), &rxconf, mbuf_pool);
+                if (retval < 0)
+                        return retval;
+        }
+
+        txconf = dev_info.default_txconf;
+        txconf.offloads = local_port_conf.txmode.offloads;
+        /* Allocate and set up 1 TX queue per Ethernet port. */
+        for (q = 0; q < tx_rings; q++) {
+                retval = rte_eth_tx_queue_setup(port, q, nb_txd,
+                                rte_eth_dev_socket_id(port), &txconf);
+                if (retval < 0)
+                        return retval;
+        }
+
+        /* Starting Ethernet port. 8< */
+        retval = rte_eth_dev_start(port);
+        /* >8 End of starting of ethernet port. */
+        if (retval < 0)
+                return retval;
+
+        /* Display the port MAC address. */
+        struct rte_ether_addr addr;
+        retval = rte_eth_macaddr_get(port, &addr);
+        if (retval != 0)
+                return retval;
+
+        printf("Port %u MAC: %02" PRIx8 " %02" PRIx8 " %02" PRIx8
+                           " %02" PRIx8 " %02" PRIx8 " %02" PRIx8 "\n",
+                        port, RTE_ETH_ADDR_BYTES(&addr));
+
+        return 0;
+}
+
+
+char* int_to_str(int value) {
+    char* s = (char *)malloc(32);
+    if (!s) return NULL;
+    snprintf(s, 16, "%d", value);
+    return s;
+}
+
+
+int main(int argc, char** argv) {
+    unsigned int nb_ports;
+    uint16_t portid;
+    struct rte_eth_dev_info dev_info;
+
+    int ncpu = get_nprocs_conf();
+    int ctrl_core = 0;
+    int data_core = 2;
+
+    if (argc < 3) {
+        print_usage(argv[0]);
+        exit(EXIT_FAILURE);
+    }
+
+    std::string ip_address = argv[1];
+    std::string video_device = argv[2];
+
+    bool skip_format_set = false;
+    // Parse optional arguments
+    int c;
+    while (1) {
+        static struct option long_options[] = {
+            { "frame-limit", required_argument, NULL, 'l' },
+            { "pixel-format", required_argument, NULL, 'n' },
+	    { "ctrl-core", required_argument, 0, 'c'},
+            { "data-core", required_argument, 0, 'd'},
+            { "no-set-format", no_argument, NULL, 'n' },
+            { 0, 0, 0, 0 }
+        };
+        int option_index = 0;
+        c = getopt_long(argc, argv, "f:l:c:d:en", long_options, &option_index);
+        if (c == -1) break;
+
+        switch (c) {
+            case 'l':
+                num_frames = atoi(optarg);
+                break;
+            case 'f':
+                p_format = atoi(optarg);
+                break;
+            case 'c':
+                ctrl_core = atoi(optarg);
+                break;
+            case 'd':
+                data_core = atoi(optarg);
+                break;
+            case 'n':
+                skip_format_set = true;
+                break;
+            default:
+                print_usage(argv[0]);
+                exit(EXIT_FAILURE);
+        }
+    }
+
+    // Validate required args
+    if (ctrl_core < 0 || data_core < 0) {
+        fprintf(stderr, "Both --ctrl-core and --data-core are required.\n");
+        print_usage(argv[0]);
+        return 2;
+    }
+
+    // Validate within CPU count
+    if (ctrl_core >= ncpu || data_core >= ncpu) {
+        fprintf(stderr, "Core index out of range. System has %d CPU(s).\n", ncpu);
+        return 2;
+    }
+
+    printf("[info] System CPUs: %d\n", ncpu);
+    printf("[info] Control thread -> core %d\n", ctrl_core);
+    printf("[info] Data thread    -> core %d\n", data_core);
+
+    char *_argv[] = {argv[0], (char *)"-l", (char *)int_to_str(ctrl_core),
+                (char *)"--log-level", (char *)"8"};
+    int _argc = sizeof(_argv) / (sizeof(_argv[0]));
+
+    if (rte_eal_init(_argc, (char **)_argv) < 0) {
+        perror("Failed to init eal");
+        exit(EXIT_FAILURE);
+    }
+
+    struct sigaction sa;
+    sa.sa_handler = handle_signal;
+    sigemptyset(&sa.sa_mask);
+    sa.sa_flags = SA_RESTART;
+
+    // Register signals
+    sigaction(SIGINT, &sa, NULL);   // Ctrl+C
+    sigaction(SIGTERM, &sa, NULL);
+    sigaction(SIGSEGV, &sa, NULL);
+    sigaction(SIGHUP, &sa, NULL);
+
+    nb_ports = rte_eth_dev_count_avail();
+    printf("*****Available DPDK ports = %d ****\n", nb_ports);
+    /* Allocates mempool to hold the mbufs. 8< */
+    mbuf_pool = rte_pktmbuf_pool_create("MBUF_POOL", NUM_MBUFS * nb_ports,
+             MBUF_CACHE_SIZE, 0, 8192/*RTE_MBUF_DEFAULT_BUF_SIZE*/, rte_socket_id());
+    /* >8 End of allocating mempool to hold mbuf. */
+
+    if (mbuf_pool == NULL) {
+            perror("Cannot create mbuf pool\n");
+        exit(EXIT_FAILURE);
+   }
+
+    /* Initializing all ports. 8< */
+    RTE_ETH_FOREACH_DEV(portid) {
+#ifdef EXTRA_DEBUGS
+	    printf("rte_eth_dev_is_valid_port = %d and id = %d\n", rte_eth_dev_is_valid_port(portid), portid);
+#endif
+           if (port_init(portid, mbuf_pool) != 0) {
+                printf("Cannot init port %d\n",portid);
+		exit(EXIT_FAILURE);
+	   }
+	   if (rte_eth_dev_is_valid_port(portid))
+		   break;
+    }
+    int ret = rte_eth_dev_info_get(portid, &dev_info);
+    printf("DPDK Devide ID = %d and driver name = %s\n", portid, dev_info.driver_name);
+
+     // Map ISI base
+	size_t ccsr_addr, ccsr_size;
+    int isi_fd = open("/dev/mem", O_RDWR);
+
+    parse_ccsr_addr(&ccsr_addr, &ccsr_size);
+	if (isi_fd) {
+		isi_baseaddr_v = mmap(NULL, ccsr_size, PROT_READ | PROT_WRITE,
+				      MAP_SHARED, isi_fd, ccsr_addr);
+		if (isi_baseaddr_v == MAP_FAILED) {
+			perror("Can not map CCSR base");
+			close(isi_fd);
+            exit(EXIT_FAILURE);
+		}
+		close(isi_fd);
+	} else {
+		perror("Failed to open /dev/mem");
+        exit(EXIT_FAILURE);
+	}
+
+    // Open V4L2 device
+    int fd = open(video_device.c_str(), O_RDWR | O_NONBLOCK);
+    if (fd < 0) {
+        perror("Failed to open video device");
+        exit(EXIT_FAILURE);
+    }
+
+    // Get or set format
+    struct v4l2_format fmt = {};
+    fmt.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+
+    if (skip_format_set) {
+        // Just get the current format
+        if (xioctl(fd, VIDIOC_G_FMT, &fmt) < 0) {
+            perror("Failed to get format");
+            close(fd);
+            exit(EXIT_FAILURE);
+        }
+        printf("Using current format from device\n");
+    } else {
+        // Get current format first
+        if (xioctl(fd, VIDIOC_G_FMT, &fmt) < 0) {
+            perror("Failed to get format");
+            close(fd);
+            exit(EXIT_FAILURE);
+        }
+
+        // Try to set BG10 format
+	switch (p_format) {
+	case 0:
+		fmt.fmt.pix_mp.pixelformat = V4L2_PIX_FMT_SBGGR10;
+		printf("Using pixel format V4L2_PIX_FMT_SBGGR10\n");
+		break;
+	case 1:
+	default:
+		fmt.fmt.pix_mp.pixelformat = V4L2_PIX_FMT_SRGGB12;
+		printf("Using pixel format V4L2_PIX_FMT_SRGGB12\n");
+	}
+        fmt.fmt.pix_mp.field = V4L2_FIELD_NONE;
+	fmt.fmt.pix_mp.width       = CAMERA_WIDTH;
+        fmt.fmt.pix_mp.height      = CAMERA_HEIGHT;
+	fmt.fmt.pix_mp.plane_fmt[0].bytesperline  = CAMERA_WIDTH * 2 + CAMERA_LINE_RESERVE;
+        fmt.fmt.pix_mp.plane_fmt[0].sizeimage  = fmt.fmt.pix_mp.plane_fmt[0].bytesperline * CAMERA_HEIGHT;
+
+        if (xioctl(fd, VIDIOC_S_FMT, &fmt) < 0) {
+            perror("Failed to set format (try using --no-set-format)");
+            close(fd);
+            exit(EXIT_FAILURE);
+        }
+    }
+
+
+	switch (p_format) {
+	case 0:
+		// Verify it's BG10 format
+		if (fmt.fmt.pix_mp.pixelformat != V4L2_PIX_FMT_SBGGR10) {
+			fprintf(stderr, "Error: Expected BG10 format (0x%x), got 0x%x\n",
+					V4L2_PIX_FMT_SBGGR10, fmt.fmt.pix_mp.pixelformat);
+			close(fd);
+			exit(EXIT_FAILURE);
+		}
+		break;
+	case 1:
+	default:
+		if (fmt.fmt.pix_mp.pixelformat != V4L2_PIX_FMT_SRGGB12) {
+			fprintf(stderr, "Error: Expected GB12 format (0x%x), got 0x%x\n",
+					V4L2_PIX_FMT_SRGGB12, fmt.fmt.pix_mp.pixelformat);
+			close(fd);
+			exit(EXIT_FAILURE);
+		}
+	}
+
+
+    unsigned int width = fmt.fmt.pix_mp.width;
+    unsigned int height = fmt.fmt.pix_mp.height;
+    size_t v4l2_frame_size = fmt.fmt.pix_mp.plane_fmt[0].sizeimage;
+    size_t bytes_per_line = fmt.fmt.pix_mp.plane_fmt[0].bytesperline;
+
+    printf("V4L2 format: %ux%u, frame size: %zu B , Stride %zu B\n", width, height, v4l2_frame_size, bytes_per_line);
+    // Calculate CSI frame size
+    size_t header_size = METADATA_BYTES + (OPTICAL_BLACK_LINES * bytes_per_line);
+    size_t packed_image_size = (width * height * 10) / 8;
+    size_t csi_frame_size = header_size + packed_image_size;
+
+#ifdef EXTRA_DEBUGS
+    printf("CSI frame size: %zu bytes (header: %zu, image: %zu)\n",
+           csi_frame_size, header_size, packed_image_size);
+#endif
+
+    const size_t raw_bytes_per_line = width * sizeof(uint16_t);
+    const size_t raw_image_size     = raw_bytes_per_line * height;
+    printf("RAW Bayer mode: 2D uint16 [%u x %u], %zu bytes\n",
+           width, height, raw_image_size);
+    // Allocate conversion buffer
+    std::vector<uint8_t> csi_frame(raw_image_size, 0);
+
+    // Request buffers - use minimum for lower latency
+    struct v4l2_requestbuffers req = {};
+    req.count = NUM_BUFFERS;
+    req.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+    req.memory = V4L2_MEMORY_MMAP;
+
+    if (xioctl(fd, VIDIOC_REQBUFS, &req) < 0) {
+        perror("Failed to request buffers");
+        close(fd);
+        exit(EXIT_FAILURE);
+    }
+
+    printf("Allocated %d buffers\n", req.count);
+	if (req.count < NUM_BUFFERS) {
+        perror("Failed to request min buffers");
+        close(fd);
+		exit(EXIT_FAILURE);
+	}
+
+
+    // Map buffers
+    struct buffer buffers[NUM_BUFFERS];
+    for (unsigned int i = 0; i < req.count; i++) {
+        struct v4l2_buffer buf = {};
+        struct v4l2_plane planes[1];
+        int p_idx = 0;
+
+        buf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+        buf.memory = V4L2_MEMORY_MMAP;
+        buf.m.planes = planes;
+        buf.length = 1;
+        buf.index = i;
+
+        if (xioctl(fd, VIDIOC_QUERYBUF, &buf) < 0) {
+            close(fd);
+            perror("Failed to query buffer");
+            exit(EXIT_FAILURE);
+        }
+
+        buffers[i].length[p_idx] = buf.m.planes[p_idx].length;
+        buffers[i].start[p_idx] = mmap(NULL, buf.m.planes[p_idx].length, PROT_READ | PROT_WRITE,
+                                MAP_SHARED, fd, buf.m.planes[p_idx].m.mem_offset);
+        if (buffers[i].start == MAP_FAILED) {
+            perror("Failed to mmap buffer");
+            close(fd);
+            exit(EXIT_FAILURE);
+        }
+
+        if (xioctl(fd, VIDIOC_QUERYBUF, &buf) < 0) {
+            perror("Failed to query buffer");
+            close(fd);
+            exit(EXIT_FAILURE);
+        }
+		buffers[i].phys_addr[p_idx] = buf.m.planes[p_idx].m.mem_offset;
+        printf("Mapping Phyaddr 0x%X Length %zu --> mapped vaddr[%d] %p\n",
+                buffers[i].phys_addr[p_idx], buffers[i].length[p_idx], i, buffers[i].start);
+    }
+
+    // Queue buffers
+    for (unsigned int i = 0; i < req.count; i++) {
+        struct v4l2_buffer buf = {};
+        struct v4l2_plane planes[1];
+        buf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+        buf.memory = V4L2_MEMORY_MMAP;
+        buf.index = i;
+        buf.m.planes = planes;
+        buf.length = 1;
+
+        if (xioctl(fd, VIDIOC_QBUF, &buf) < 0) {
+            perror("Failed to queue buffer");
+            close(fd);
+            exit(EXIT_FAILURE);
+        }
+    }
+
+    // Start streaming
+    enum v4l2_buf_type type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+    if (xioctl(fd, VIDIOC_STREAMON, &type) < 0) {
+        perror("Failed to start streaming");
+        close(fd);
+        exit(EXIT_FAILURE);
+    }
+
+    printf("V4L2 streaming started\n");
+
+    // Setup HSB Emulator
+    HSBEmulator hsb;
+    uint8_t data_plane_id = 0;
+    uint8_t sensor_id = 0;
+    LinuxDataPlane linux_data_plane(
+        hsb,
+        IPAddress_from_string(ip_address),
+        data_plane_id,
+        sensor_id);
+
+    hsb.start();
+    printf("Streaming from %s to %s ... Press Ctrl+C to stop\n",
+           video_device.c_str(), ip_address.c_str());
+
+    int i;
+    size_t src_bpl = fmt.fmt.pix_mp.plane_fmt[0].bytesperline
+                       ? fmt.fmt.pix_mp.plane_fmt[0].bytesperline
+                       : width * sizeof(uint16_t);
+
+	int64_t shape[1] = { width };
+	DLTensor tensor1d = {
+		.device = { .device_type = kDLCPU, .device_id = 0 },
+		.ndim = 1,
+		.dtype = DLDataType{ .code = kDLUInt, .bits = 16, .lanes = 1 },
+		.shape = shape,
+		.strides = nullptr,
+		.byte_offset = 0
+	};
+
+
+	/* use 1 & 2 indexed buffer */
+	for (i = 1; i <= 2; ++i)
+		isi_channel_set_outbuf(buffers[i].phys_addr[0], i);
+	// Disable ISI IRQ
+	rte_write32(0, (uint8_t *)isi_baseaddr_v + CHNL_IER);
+
+#ifdef ENABLE_LATENCY
+	auto start_time = std::chrono::steady_clock::now();
+	// For latency measurement
+	auto last_report_time = start_time;
+#endif
+
+	// Capture and send frames
+	unsigned int frame_count = 0;
+	unsigned int frames_since_report = 0;
+
+	int bufid, status = 0, frame_ready = 0;
+	int line_no = 0, is_last = 0, line_ready_cnt = 0;
+	size_t   frame_bytes = 0;
+	uint32_t offset = frame_bytes;
+
+
+cpu_set_t set;
+    CPU_ZERO(&set);
+    CPU_SET(data_core, &set);
+
+if (sched_setaffinity(0, sizeof(set), &set) != 0) {
+        perror("sched_setaffinity");
+        return 1;
+    }
+
+
+	int core = sched_getcpu();
+    printf("Data processing on CPU core: %d\n", core);
+
+#ifdef CAMERA_DATAPATH_FRAMESTATUS
+	while (num_frames == 0 || frame_count < num_frames) {
+#ifdef ENABLE_LATENCY
+		auto frame_start = std::chrono::steady_clock::now();
+#endif
+        /* Wait for next Frame to start */
+        while (!frame_ready) {
+	        status = rte_read32((uint8_t *)isi_baseaddr_v + CHNL_STS);
+		    rte_write32(rte_cpu_to_le_32(status), (uint8_t *)isi_baseaddr_v + CHNL_STS);
+			if (status & CHNL_STS_FRM_STRD_MASK)
+                frame_ready = 1;
+            //usleep(10);
+        }
+        // Current Buffer
+	    bufid = ((status >> 8) & 0x3);
+		line_no = is_last = frame_bytes = offset = frame_ready = 0;
+
+//        usleep(100); // Lets some lines get populated
+		while (line_no < height) {
+			status = rte_read32((uint8_t *)isi_baseaddr_v + CHNL_STS);
+			rte_write32(rte_cpu_to_le_32(status), (uint8_t *)isi_baseaddr_v + CHNL_STS);
+            /* Check if current Frame already comepleted */
+			if (status & CHNL_STS_FRM_STRD_MASK)
+                frame_ready = 1;
+			if (status & CHNL_STS_LINE_STRD_MASK)
+                line_ready_cnt++;
+
+			if (frame_ready){
+			    // send all remainaing lines
+				while (line_no < height) {
+				    offset = frame_bytes;
+				    if (line_no == height - N_LINE_CONSUMED)
+					    is_last = 1;
+				    else
+					    is_last = 0;
+					tensor1d.data = static_cast<void*>((uint8_t*)buffers[bufid].start[0] + offset);
+					linux_data_plane.send_dpdk(tensor1d, mbuf_pool, portid,
+							ext_buf_free_callback_fn,
+							line_no, is_last,  buffers[bufid].phys_addr[0] + offset);
+				    frame_bytes += src_bpl * N_LINE_CONSUMED;
+				    line_no = line_no + N_LINE_CONSUMED;
+				}
+                /* Here means we just sent last frame and are behind ISI rate.
+                   Continue sending next in progress frame */
+		        break;
+			}
+			//bufid = ((status >> 8) & 0x3);
+			if (line_ready_cnt == N_LINE_CONSUMED) {
+                line_ready_cnt = 0;
+				offset = frame_bytes;
+				if (line_no == height - N_LINE_CONSUMED)
+					is_last = 1;
+				else
+					is_last = 0;
+				tensor1d.data = static_cast<void*>((uint8_t*)buffers[bufid].start[0] + offset);
+				linux_data_plane.send_dpdk(tensor1d, mbuf_pool, portid,
+						ext_buf_free_callback_fn,
+						line_no, is_last,  buffers[bufid].phys_addr[0] + offset);
+				frame_bytes += src_bpl * N_LINE_CONSUMED;
+				line_no = line_no + N_LINE_CONSUMED;
+			}
+		}
+#else
+
+    /* Wait for next Frame to start */
+    while (1) {
+	    status = rte_read32((uint8_t *)isi_baseaddr_v + CHNL_STS);
+		rte_write32(rte_cpu_to_le_32(status), (uint8_t *)isi_baseaddr_v + CHNL_STS);
+		if (status & CHNL_STS_FRM_STRD_MASK)
+            break;
+    }
+	bufid = ((status >> 8) & 0x3);
+	while (num_frames == 0 || frame_count < num_frames) {
+#ifdef ENABLE_LATENCY
+		auto frame_start = std::chrono::steady_clock::now();
+#endif
+		line_no = is_last = frame_bytes = offset = 0;
+
+		while (line_no < height) {
+			status = rte_read32((uint8_t *)isi_baseaddr_v + CHNL_STS);
+			rte_write32(rte_cpu_to_le_32(status), (uint8_t *)isi_baseaddr_v + CHNL_STS);
+			if (status & CHNL_STS_LINE_STRD_MASK){
+#ifdef EXTRA_DEBUGS
+				printf("------ ISI STATUS 0x%X : frame[%d] ready. Got Lined %d frame_bytes %d\n", status, bufid, line_no, frame_bytes);
+#endif
+				offset = frame_bytes;
+				if (line_no == height - N_LINE_CONSUMED)
+					is_last = 1;
+				else
+					is_last = 0;
+				tensor1d.data = static_cast<void*>((uint8_t*)buffers[bufid].start[0] + offset);
+				linux_data_plane.send_dpdk(tensor1d, mbuf_pool, portid,
+						ext_buf_free_callback_fn,
+						line_no, is_last, buffers[bufid].phys_addr[0] + offset);
+				frame_bytes += src_bpl * N_LINE_CONSUMED;
+				line_no = line_no + N_LINE_CONSUMED;
+			}
+		}
+	    if (bufid == 1)
+            bufid = 2;
+        else
+            bufid = 1;
+#endif
+		frame_count++;
+#ifdef ENABLE_LATENCY
+		//auto dequeue_time = std::chrono::steady_clock::now();
+		frames_since_report++;
+
+		// Report timing every second
+		auto now = std::chrono::steady_clock::now();
+		auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(now - last_report_time).count();
+
+		if (elapsed >= PRINT_INT) {
+			double actual_fps = frames_since_report * 1000 / elapsed;
+			auto dequeue_us = std::chrono::duration_cast<std::chrono::microseconds>(now - frame_start).count();
+			printf("Frame %u | FPS: %.2f | Latency - Total: %ld us\n",
+					frame_count, actual_fps, dequeue_us);
+
+			last_report_time = now;
+			frames_since_report = 0;
+		}
+#endif
+	}
+
+#ifdef ENABLE_LATENCY
+    auto end_time = std::chrono::steady_clock::now();
+    auto total_time = std::chrono::duration_cast<std::chrono::milliseconds>(end_time - start_time).count();
+    double avg_fps = frame_count * 1000.0 / total_time;
+#endif
+
+    // Cleanup
+    printf("\nStopping streaming...\n");
+    xioctl(fd, VIDIOC_STREAMOFF, &type);
+
+    for (unsigned int i = 0; i < req.count; i++) {
+        munmap(buffers[i].start[0], buffers[i].length[0]);
+    }
+
+    close(fd);
+    hsb.stop();
+
+    RTE_ETH_FOREACH_DEV(portid) {
+                printf("Closing port %d...", portid);
+                rte_eth_dev_stop(portid);
+                rte_eth_dev_close(portid);
+                printf(" Done\n");
+        }
+
+   /* clean up the EAL */
+   rte_eal_cleanup();
+#ifdef ENABLE_LATENCY
+   printf("Streaming stopped. Sent %u frames in %ld ms (avg %.2f fps)\n",
+           frame_count, total_time, avg_fps);
+#endif
+    return 0;
+}
