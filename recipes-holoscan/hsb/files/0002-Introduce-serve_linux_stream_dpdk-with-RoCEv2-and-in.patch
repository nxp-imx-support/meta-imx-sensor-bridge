+static inline uint32_t crc32_hw_ieee(uint32_t crc, const uint8_t *buf, size_t len) {
+    if (!buf) return 0;
+    crc = ~crc;
+
+    // Align to 8 bytes
+    while (len && ((uintptr_t)buf & 7)) {
+        crc = __crc32b(crc, *buf++);
+        len--;
+    }
+
+    // 64-bit bulk
+    const uint64_t *p = (const uint64_t *)buf;
+    size_t n64 = len >> 3;
+    for (size_t i = 0; i < n64; i++) {
+        crc = __crc32d(crc, p[i]);
+    }
+
+    // tail bytes
+    buf += (n64 << 3);
+    len  &= 7;
+    while (len--) {
+        crc = __crc32b(crc, *buf++);
+    }
+    return ~crc;
+}
