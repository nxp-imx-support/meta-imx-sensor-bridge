+// ---------------------------
+// DLPack helpers (define once)
+// ---------------------------
+namespace {
+  static inline size_t tensor_num_elems(const DLTensor& t) {
+    size_t n = 1;
+    for (int i = 0; i < t.ndim; ++i) n *= static_cast<size_t>(t.shape[i]);
+    return n;
+  }
+  static inline size_t tensor_elem_bytes(const DLTensor& t) {
+    return static_cast<size_t>((t.dtype.bits * t.dtype.lanes + 7) / 8);
+  }
+  static inline size_t tensor_nbytes(const DLTensor& t) {
+    return tensor_num_elems(t) * tensor_elem_bytes(t);
+  }
+
+  template <typename T>
+  void fill_gradient(void* data, size_t num_elems, T start, T step) {
+    auto* p = static_cast<T*>(data);
+    for (size_t i = 0; i < num_elems; ++i) p[i] = static_cast<T>(start + step * static_cast<T>(i));
+  }
+
+  void fill_buffer_with_pattern(DLTensor& t, uint64_t seed) {
+    if (!t.data) return;
+    const size_t num_elems = tensor_num_elems(t);
+    const size_t elem_bytes = tensor_elem_bytes(t);
+
+    switch (t.dtype.code) {
+      case kDLUInt:
+      case kDLInt:
+        if (elem_bytes == 1) {
+          fill_gradient<uint8_t>(t.data, num_elems, static_cast<uint8_t>(seed & 0xFF), 1);
+        } else if (elem_bytes == 2) {
+          fill_gradient<uint16_t>(t.data, num_elems, static_cast<uint16_t>(seed & 0xFFFF), 257);
+        } else if (elem_bytes == 4) {
+          fill_gradient<uint32_t>(t.data, num_elems, static_cast<uint32_t>(seed), 0x01010101u);
+        } else if (elem_bytes == 8) {
+          fill_gradient<uint64_t>(t.data, num_elems, static_cast<uint64_t>(seed), 0x0101010101010101ULL);
+        } else {
+          std::memset(t.data, 0, tensor_nbytes(t));
+        }
+        break;
+
+      case kDLFloat:
+        if (elem_bytes == 4) {
+          float* p = static_cast<float*>(t.data);
+          const float base = static_cast<float>((seed % 256) / 255.0f);
+          for (size_t i = 0; i < num_elems; ++i) p[i] = base + 0.001f * static_cast<float>(i);
+        } else if (elem_bytes == 8) {
+          double* p = static_cast<double*>(t.data);
+          const double base = static_cast<double>((seed % 256) / 255.0);
+          for (size_t i = 0; i < num_elems; ++i) p[i] = base + 0.001 * static_cast<double>(i);
+        } else {
+          std::memset(t.data, 0, tensor_nbytes(t));
+        }
+        break;
+
+      default:
+        std::memset(t.data, 0, tensor_nbytes(t));
+        break;
+    }
+  }
+
+  // Try to read a raw frame from disk into the tensor buffer
+  bool read_file_into_tensor(const std::string& path, DLTensor& out) {
+    if (!out.data) return false;
+    std::ifstream f(path, std::ios::binary);
+    if (!f) return false;
+
+    f.seekg(0, std::ios::end);
+    const std::streamoff fsize = f.tellg();
+    f.seekg(0, std::ios::beg);
+
+    const size_t nbytes = tensor_nbytes(out);
+    if (fsize <= 0) return false;
+
+    std::vector<char> buf(static_cast<size_t>(fsize));
+    f.read(buf.data(), buf.size());
+    if (!f) return false;
+
+    // Copy min(file_size, tensor_size) bytes
+    const size_t to_copy = std::min(nbytes, buf.size());
+    std::memcpy(out.data, buf.data(), to_copy);
+
+    // Zero the remainder if file is smaller than tensor
+    if (to_copy < nbytes) {
+      std::memset(static_cast<char*>(out.data) + to_copy, 0, nbytes - to_copy);
+      std::fprintf(stderr,
+                   "[CPU] %s: file smaller than tensor (%zu < %zu); zero-filled remainder\n",
+                   path.c_str(), static_cast<size_t>(buf.size()), nbytes);
+    } else if (buf.size() > nbytes) {
+      std::fprintf(stderr,
+                   "[CPU] %s: file larger than tensor (%zu > %zu); truncated\n",
+                   path.c_str(), static_cast<size_t>(buf.size()), nbytes);
+    }
+    return true;
+  }
